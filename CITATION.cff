cff-version: 1.2.0
message: >-
  Please cite this software when using spinq-vqe for VQE/QAOA workflows,
  Kagome antiferromagnet simulations, or SOC material screening. Prefer the
  Zenodo concept DOI below for the code artifact; cite any related paper DOI
  separately once published.
type: software
title: "spinq-vqe: Variational Quantum Simulation of Antiferromagnetic Hamiltonians"
version: "0.1.5"
date-released: 2026-08-06
url: "https://github.com/ARPAQLS/spinq-vqe"
repository-code: "https://github.com/ARPAQLS/spinq-vqe"
license: MIT
authors:
  - family-names: Peilivanidis
    given-names: Vladimiros
    email: "qondra@arpacorp.net"
    affiliation: "ARPA Quantum Logical Systems (QONDRA)"
    orcid: "https://orcid.org/0009-0003-0121-465X"
  - name: "ARPA Quantum Logical Systems (QONDRA)"
    email: "qondra@arpacorp.net"
identifiers:
